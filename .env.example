# ==============================================================================
# BirthdayVerse Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real tokens, encryption keys, or secrets to version control.
# In production on Render, configure these in the Render Dashboard Environment settings.

# ------------------------------------------------------------------------------
# 1. CANONICAL GITHUB DATA REPOSITORY (REQUIRED - NON-NEGOTIABLE)
# ------------------------------------------------------------------------------
# The exact private GitHub repository used as the single source of truth.
# Format: owner/repo
GITHUB_DATA_REPO=your-org-or-username/birthdayverse-data

# The git branch to persist data to (default: main)
GITHUB_DATA_BRANCH=main

# Fine-Grained Personal Access Token (PAT) restricted ONLY to the data repository.
# Minimum required permission: Contents: Read and write
GITHUB_DATA_TOKEN=github_pat_example_token_replace_with_real_one

# GitHub REST API base URL (default: https://api.github.com)
GITHUB_API_URL=https://api.github.com

# GitHub API Version header (default: 2022-11-28)
GITHUB_API_VERSION=2022-11-28

# Committer identity for automated Git commits
GITHUB_COMMITTER_NAME=BirthdayVerse
GITHUB_COMMITTER_EMAIL=bot@birthdayverse.internal

# ------------------------------------------------------------------------------
# 2. ENCRYPTION AT REST (REQUIRED - SERVER-ONLY)
# ------------------------------------------------------------------------------
# 256-bit (32-byte) AES-256-GCM encryption key formatted as a 64-character hex string.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. APPLICATION & SESSION SECRETS (REQUIRED - SERVER-ONLY)
# ------------------------------------------------------------------------------
# Canonical public application URL
NEXT_PUBLIC_APP_URL=https://birthdayverse.onrender.com

# Secret used to sign creator session cookies
SESSION_SECRET=super_secret_session_signing_key_at_least_32_chars_long

# Secret used to derive management verification tokens
MANAGEMENT_TOKEN_SECRET=super_secret_management_key_at_least_32_chars_long

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI WRITING ASSISTANT (OPTIONAL)
# ------------------------------------------------------------------------------
# If left empty, the application runs seamlessly with manual writing modes.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. LOCAL DEVELOPMENT / CI TEST FLAG (TEST-ONLY)
# ------------------------------------------------------------------------------
# When set to true, uses the fast in-memory mock persistence adapter for isolated testing.
# In production on Render, this MUST be false or left unset so real GitHub persistence is used.
MOCK_GITHUB=false
