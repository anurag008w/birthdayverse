{
  "name": "birthdayverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive, personalized birthday experiences backed exclusively by a dedicated GitHub data repository.",
  "scripts": {
    "dev": "node --experimental-strip-types server/index.mjs --dev",
    "preflight": "node scripts/preflight.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --experimental-strip-types server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "MOCK_GITHUB=true node --experimental-strip-types --test tests/*.test.mjs",
    "data:init": "node --experimental-strip-types scripts/data-init.mjs",
    "data:check": "node --experimental-strip-types scripts/data-check.mjs",
    "data:repair": "node --experimental-strip-types scripts/data-repair.mjs",
    "data:migrate": "node --experimental-strip-types scripts/data-migrate.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.395.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.18.20",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4"
  }
}
